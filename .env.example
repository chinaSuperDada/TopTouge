# ---- 本地开发 ----
# 复制为 .env：cp .env.example .env

PORT=3000

# 固定测试用户（阶段一不做登录）
TEST_USER_ID=test-user-001

# 累计写入阈值，供权限门禁钩子读取
TOPTOUGE_WRITE_THRESHOLD=50

# 数据源：memory（本地开发，重启即重置）| mysql（线上）
DATA_SOURCE=memory

# ---- MySQL（仅 DATA_SOURCE=mysql 时需要）----
# 云托管的内网 MySQL 会自动注入 MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD，
# 不用手填。只有连公网数据库或本地 MySQL 时才需要下面这些。
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=toptouge
# DB_SSL=false
