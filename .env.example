# 本地后端环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env

# 后端监听端口
PORT=3000

# 固定测试用户（阶段一不做登录）
TEST_USER_ID=test-user-001

# 累计写入阈值，供权限门禁钩子读取（.claude/hooks/permission-gate.sh）
TOPTOUGE_WRITE_THRESHOLD=50

# 数据源：memory（内存 mock，当前使用）| postgres（后续接数据库时启用）
DATA_SOURCE=memory

# 以下仅在 DATA_SOURCE=postgres 时需要
# DATABASE_URL=postgres://postgres:dev@localhost:5432/toptouge
