<view class="section">
  <view class="section-head">
    <text class="section-title">车友评论</text>
    <text class="count" wx:if="{{rows.length > 0}}">{{rows.length}}</text>
  </view>

  <block wx:if="{{rows.length > 0}}">
    <view class="item" wx:for="{{rows}}" wx:key="id">
      <view class="item-head">
        <text class="user">{{item.userId}}</text>
        <text class="time">{{item.timeText}}</text>
      </view>
      <text class="content">{{item.content}}</text>
    </view>
  </block>

  <view class="empty" wx:else>还没有评论，来说两句</view>

  <view class="composer">
    <input
      class="input composer-input"
      value="{{input}}"
      placeholder="说点什么…"
      placeholder-class="input-placeholder"
      maxlength="500"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSubmit"
    />
    <view class="send {{submitting ? 'send-disabled' : ''}}" bindtap="onSubmit">发送</view>
  </view>
</view>
