<view class="panel">
  <view class="panel-head">
    <text class="section-title">难度信息</text>

    <!-- 星级：五格方块，已点亮的是当前难度 -->
    <view class="star-badge">
      <view class="stars">
        <view
          class="star {{si < route.difficultyStars ? 'star-on' : ''}}"
          wx:for="{{[1,2,3,4,5]}}"
          wx:for-item="s"
          wx:for-index="si"
          wx:key="*this"
        ></view>
      </view>
      <text class="star-text">{{difficultyLabel}}</text>
    </view>
  </view>

  <view class="grid">
    <view class="cell" wx:for="{{metrics}}" wx:key="label">
      <text class="cell-value t-num">{{item.value}}</text>
      <text class="cell-label">{{item.label}}</text>
    </view>
  </view>

  <view class="divider"></view>

  <view class="meta-row">
    <view class="meta-item" wx:for="{{meta}}" wx:key="label">
      <text class="meta-label">{{item.label}}</text>
      <text class="meta-value">{{item.value}}</text>
    </view>
  </view>
</view>
