.panel {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-3);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

/* section-title 自带强调色竖条与下边距，这里只需要水平居中 */
.panel-head .section-title {
  margin-bottom: 0;
}

.star-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding: 10rpx var(--space-2);
  background: var(--accent-dim);
  border: 2rpx solid var(--accent-border);
  border-radius: var(--radius-sm);
}

.stars {
  display: flex;
}

/* 五格方块表示难度，与列表页卡片一致 */
.star {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: var(--star-empty);
  margin-left: 6rpx;
}

.star-on {
  background: var(--accent);
}

/* 星级对应的文字，如「中等」 */
.star-text {
  font-size: var(--fs-caption);
  color: var(--accent);
  margin-top: 6rpx;
}

/* ---------- 指标网格 ---------- */

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 33.33%;
  box-sizing: border-box;
  padding: var(--space-2) var(--space-1) var(--space-2) 0;
  display: flex;
  flex-direction: column;
}

.cell-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  line-height: 1.15;
  margin-bottom: 8rpx;
}

.cell-label {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}

/* ---------- 辅助信息 ---------- */

.meta-row {
  display: flex;
  flex-wrap: wrap;
}

.meta-item {
  margin-right: var(--space-4);
  margin-bottom: var(--space-1);
}

.meta-label {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-right: 8rpx;
}

.meta-value {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}
