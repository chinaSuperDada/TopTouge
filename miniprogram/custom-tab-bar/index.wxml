<view class="tabbar">
  <!-- 左：跑山路线 -->
  <view
    class="tab"
    style="color: {{selected === 0 ? colorActive : colorNormal}}"
    data-index="0"
    bindtap="onTabTap"
  >
    <view class="icon icon-home" style="border-color: {{selected === 0 ? colorActive : colorNormal}}"></view>
    <text class="tab-label" style="color: {{selected === 0 ? colorActive : colorNormal}}">跑山路线</text>
  </view>

  <!-- 跑山活动 -->
  <view
    class="tab"
    style="color: {{selected === 1 ? colorActive : colorNormal}}"
    data-index="1"
    bindtap="onTabTap"
  >
    <view class="icon icon-activity">
      <view class="flag-pole" style="background: {{selected === 1 ? colorActive : colorNormal}}"></view>
      <view class="flag-cloth" style="border-color: {{selected === 1 ? colorActive : colorNormal}}"></view>
    </view>
    <text class="tab-label" style="color: {{selected === 1 ? colorActive : colorNormal}}">跑山活动</text>
  </view>

  <!-- 中：凸起的制作按钮 -->
  <view class="tab tab-center" bindtap="onCreateTap">
    <view class="create-btn" style="background: {{colorActive}}">
      <text class="plus">＋</text>
    </view>
  </view>

  <!-- 右：我的 -->
  <view
    class="tab"
    style="color: {{selected === 2 ? colorActive : colorNormal}}"
    data-index="2"
    bindtap="onTabTap"
  >
    <view class="icon icon-mine">
      <view class="head" style="border-color: {{selected === 2 ? colorActive : colorNormal}}"></view>
      <view class="shoulder" style="border-color: {{selected === 2 ? colorActive : colorNormal}}"></view>
    </view>
    <text class="tab-label" style="color: {{selected === 2 ? colorActive : colorNormal}}">我的</text>
  </view>
</view>
