/**
 * ⚠️ 这里全部用写死的颜色，不要改成 CSS 变量。
 *
 * custom-tab-bar 渲染在 page 标签之外，拿不到 app.wxss 里定义在
 * page 选择器下的变量。用 var() 会静默失效，表现为深色底上元素
 * 变成默认黑色 —— 看起来像「没渲染」，极难排查。
 *
 * 颜色值与 styles/tokens.wxss 手动保持同步。
 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  /* 让出 iPhone 底部安全区 */
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: #141414;
  border-top: 2rpx solid rgba(255, 255, 255, 0.07);
  display: flex;
  align-items: center;
  /* 必须足够高，否则会被页面内容盖住 */
  z-index: 9999;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 110rpx;
}

.tab-label {
  /* 五个位置后横向空间更紧，「跑山路线」四个字要缩一点才不挤 */
  font-size: 18rpx;
  margin-top: 6rpx;
  white-space: nowrap;
}

/* ---------- 图标：CSS 画，不引图片资源 ---------- */

.icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

/* 首页：圆角方块轮廓 */
.icon-home {
  border: 4rpx solid #6e6e6e;
  border-radius: 8rpx;
  box-sizing: border-box;
}

/* 我的：圆头 + 肩膀弧 */
.icon-mine {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.head {
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid #6e6e6e;
  border-radius: 50%;
  box-sizing: border-box;
}

.shoulder {
  width: 30rpx;
  height: 14rpx;
  margin-top: 3rpx;
  border: 4rpx solid #6e6e6e;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  box-sizing: border-box;
}

/* 跑山活动：旗杆 + 旗面 */
.icon-activity {
  position: relative;
}

.flag-pole {
  position: absolute;
  left: 4rpx;
  top: 0;
  width: 4rpx;
  height: 40rpx;
}

.flag-cloth {
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 26rpx;
  height: 18rpx;
  border: 4rpx solid #6e6e6e;
  border-left: none;
  box-sizing: border-box;
}

/* 消息：对话气泡 + 左下角小尾巴 */
.icon-msg {
  position: relative;
}

.msg-body {
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 32rpx;
  height: 26rpx;
  border: 4rpx solid #6e6e6e;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.msg-tail {
  position: absolute;
  left: 10rpx;
  top: 26rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 4rpx solid #6e6e6e;
  border-bottom: 4rpx solid #6e6e6e;
  transform: skewX(-20deg);
}

/* ---------- 中间凸起按钮 ---------- */

.tab-center {
  /* 向上提，做出凸起效果 */
  transform: translateY(-28rpx);
}

.create-btn {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(12, 156, 252, 0.4);
  /* 与 TabBar 同色的描边，让按钮看起来浮在上面。
     颜色要和 .tabbar 的 background 一致 */
  border: 8rpx solid #080808;
  box-sizing: content-box;
}

.create-btn:active {
  opacity: 0.85;
}

.plus {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
  /* 让加号视觉居中 —— 字符本身偏下 */
  margin-top: -6rpx;
}
