.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  /* 让出 iPhone 底部安全区 */
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: var(--bg-surface);
  border-top: 2rpx solid var(--divider);
  display: flex;
  align-items: center;
  z-index: 100;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 110rpx;
}

.tab-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.tab-on .tab-label {
  color: var(--accent);
}

/* ---------- 图标：用 CSS 画，避免引入图片资源 ---------- */

.icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

/* 首页：一个圆角方块的轮廓 */
.icon-home {
  border: 4rpx solid var(--text-tertiary);
  border-radius: 8rpx;
  box-sizing: border-box;
}

.tab-on .icon-home {
  border-color: var(--accent);
}

/* 我的：一个圆（头）加一条弧（肩） */
.icon-mine {
  width: 40rpx;
  height: 40rpx;
}

.icon-mine::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border: 4rpx solid var(--text-tertiary);
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-mine::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 2rpx;
  width: 30rpx;
  height: 16rpx;
  margin-left: -15rpx;
  border: 4rpx solid var(--text-tertiary);
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  box-sizing: border-box;
}

.tab-on .icon-mine::before,
.tab-on .icon-mine::after {
  border-color: var(--accent);
}

/* ---------- 中间凸起按钮 ---------- */

.tab-center {
  /* 稍微向上提，做出凸起效果 */
  transform: translateY(-28rpx);
}

.create-btn {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(12, 156, 252, 0.4);
  /* 与 TabBar 背景同色的描边，让按钮看起来是浮在上面的 */
  border: 8rpx solid var(--bg-base);
  box-sizing: content-box;
}

.create-btn:active {
  opacity: 0.85;
}

.plus {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
  /* 让加号视觉居中 —— 字符本身偏下 */
  margin-top: -6rpx;
}
