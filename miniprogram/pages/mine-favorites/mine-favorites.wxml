<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:else>
    <view
      class="fav-item"
      wx:for="{{routes}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="onRouteTap"
      bindlongpress="onLongPress"
    >
      <!-- 缩略图配色与首页卡片一致，按 id 取 -->
      <view class="thumb {{item.thumbClass}}">
        <text class="thumb-label">{{item.roadTypeText}}</text>
      </view>

      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <view class="item-meta">
          <text>{{item.distanceText}}</text>
          <text class="meta-dot">·</text>
          <text>{{item.curveCount}} 弯</text>
          <text class="meta-dot">·</text>
          <text>{{item.city}}</text>
        </view>
        <view class="stars">
          <view
            class="star {{si < item.difficultyStars ? 'star-on' : ''}}"
            wx:for="{{item.stars}}"
            wx:for-item="s"
            wx:for-index="si"
            wx:key="*this"
          ></view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{routes.length === 0}}">
      <text>还没有收藏</text>
      <text class="empty-hint">长按收藏项可取消</text>
    </view>
  </block>
</view>
