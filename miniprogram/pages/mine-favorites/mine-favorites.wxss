.page {
  min-height: 100vh;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
}

.fav-item {
  display: flex;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-2);
  margin-bottom: var(--space-2);
}

.fav-item:active {
  background: var(--bg-elevated);
}

/* 缩略图：与首页卡片同一套配色，按 id 取模 */
.thumb {
  position: relative;
  width: 160rpx;
  height: 130rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.thumb-0 { background: linear-gradient(150deg, #1d4ed8, #0e7490); }
.thumb-1 { background: linear-gradient(150deg, #15803d, #166534); }
.thumb-2 { background: linear-gradient(150deg, #b45309, #92400e); }
.thumb-3 { background: linear-gradient(150deg, #7e22ce, #5b21b6); }
.thumb-4 { background: linear-gradient(150deg, #be185d, #9d174d); }
.thumb-5 { background: linear-gradient(150deg, #0e7490, #155e75); }

.thumb-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(0, 0, 0, 0.3);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 10rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  padding: var(--space-1) var(--space-2) var(--space-1) var(--space-3);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-emphasis);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: var(--fs-label);
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
}

.meta-dot {
  margin: 0 8rpx;
  color: var(--text-tertiary);
}

.stars {
  display: flex;
}

.star {
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: var(--star-empty);
  margin-right: 6rpx;
}

.star-on {
  background: var(--accent);
}

.loading,
.empty {
  text-align: center;
  padding: var(--space-6) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}

.empty-hint {
  display: block;
  font-size: var(--fs-caption);
  margin-top: 12rpx;
  opacity: 0.7;
}
