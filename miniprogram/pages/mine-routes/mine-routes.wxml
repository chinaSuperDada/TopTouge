<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:else>
    <view
      class="route-item"
      wx:for="{{routes}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="onRouteTap"
      bindlongpress="onLongPress"
    >
        <view class="item-head">
          <text class="item-name">{{item.name}}</text>
          <text class="status {{item.statusClass}}">{{item.statusText}}</text>
        </view>

        <view class="item-meta">
          <text>{{item.distanceText}}</text>
          <text class="meta-dot">·</text>
          <text>{{item.curveCount}} 弯</text>
          <text class="meta-dot">·</text>
          <text>🔥 {{item.heat}}</text>
        </view>

        <view class="stars">
          <view
            class="star {{si < item.difficultyStars ? 'star-on' : ''}}"
            wx:for="{{item.stars}}"
            wx:for-item="s"
            wx:for-index="si"
            wx:key="*this"
          ></view>
        </view>
    </view>

    <view class="empty" wx:if="{{routes.length === 0}}">
      <text>还没上传过路线</text>
      <text class="empty-hint">点底部加号制作一条</text>
    </view>
  </block>
</view>
