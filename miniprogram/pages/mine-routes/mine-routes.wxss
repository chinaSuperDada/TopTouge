.page {
  min-height: 100vh;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
}

.route-item {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}

.route-item:active {
  background: var(--bg-elevated);
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-emphasis);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 审核状态徽章 */
.status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-left: var(--space-2);
  flex-shrink: 0;
}

.status-pending {
  color: var(--warn);
  background: rgba(255, 179, 64, 0.14);
}

.status-ok {
  color: var(--accent-alt);
  background: var(--accent-alt-dim);
}

.status-rejected {
  color: var(--danger);
  background: var(--danger-dim);
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: var(--fs-label);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.meta-dot {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}

.stars {
  display: flex;
}

.star {
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: var(--star-empty);
  margin-right: 6rpx;
}

.star-on {
  background: var(--accent);
}

.loading,
.empty {
  text-align: center;
  padding: var(--space-6) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}

.empty-hint {
  display: block;
  font-size: var(--fs-caption);
  margin-top: 12rpx;
  opacity: 0.7;
}
