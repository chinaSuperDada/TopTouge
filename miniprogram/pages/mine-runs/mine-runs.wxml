<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:else>
    <view
      class="run-item"
      wx:for="{{runs}}"
      wx:key="id"
      data-id="{{item.routeId}}"
      bindtap="onRouteTap"
    >
      <view class="run-main">
        <text class="run-name">{{item.routeName}}</text>
        <text class="run-meta">{{item.timeText}} · 第 {{item.rank}} / {{item.total}} 名</text>
      </view>
      <view class="run-score {{item.scoreClass}}">
        <text class="score-num t-num">{{item.score}}</text>
        <text class="score-label">分</text>
      </view>
    </view>

    <view class="empty" wx:if="{{runs.length === 0}}">
      <text>还没跑过路线</text>
      <text class="empty-hint">去首页找一条开始</text>
    </view>
  </block>
</view>
