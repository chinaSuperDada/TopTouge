.page {
  min-height: 100vh;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.ph-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.ph-desc {
  font-size: var(--fs-body);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.ph-hint {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}
