<view class="page">
  <!-- 个人信息 -->
  <view class="profile card" bindtap="onEditProfile">
    <!-- 有头像用图，没有就用昵称末两字做色块 -->
    <image class="avatar avatar-img" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" />
    <view class="avatar" wx:else>{{avatarText}}</view>

    <view class="profile-info">
      <text class="profile-name">{{userName}}</text>
      <text class="profile-sub">跑了 {{stats.runCount}} 次 · 传了 {{stats.routeCount}} 条路线</text>
    </view>

    <text class="profile-edit">编辑</text>
    <view class="mod-badge" wx:if="{{isModerator}}">版主</view>
  </view>

  <!-- 功能入口 -->
  <view class="card menu">
    <view class="menu-item" bindtap="onOpenRuns">
      <text class="menu-icon icon-run"></text>
      <text class="menu-label">我的成绩</text>
      <text class="menu-value">{{stats.runCount}} 次</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onOpenRoutes">
      <text class="menu-icon icon-route"></text>
      <text class="menu-label">我的路线</text>
      <text class="menu-value">{{stats.routeCount}} 条</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onOpenFavorites">
      <text class="menu-icon icon-fav"></text>
      <text class="menu-label">我的收藏</text>
      <text class="menu-value">{{stats.favoriteCount}} 条</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版主入口：只有版主看得到 -->
  <view class="card menu" wx:if="{{isModerator}}">
    <view class="menu-item" bindtap="onOpenModerator">
      <text class="menu-icon icon-mod"></text>
      <view class="menu-main">
        <text class="menu-label">版主工作台</text>
        <text class="menu-desc">{{moderatorRegion}} · 审核与管理</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 申请版主：已经是版主就不显示 -->
  <view class="card menu" wx:if="{{!isModerator}}">
    <view class="menu-item" bindtap="onOpenApply">
      <text class="menu-icon icon-apply"></text>
      <view class="menu-main">
        <text class="menu-label">申请成为版主</text>
        <text class="menu-desc">贡献路线、跑过山，就能申请管理你常跑的区域</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 平台管理员入口 -->
  <view class="card menu" wx:if="{{isAdmin}}">
    <view class="menu-item" bindtap="onOpenApplyReview">
      <text class="menu-icon icon-admin"></text>
      <view class="menu-main">
        <text class="menu-label">审批版主申请</text>
        <text class="menu-desc">你是平台管理员</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="onOpenSettings">
      <text class="menu-icon icon-set"></text>
      <text class="menu-label">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version">TopTouge v1.0.0</view>
</view>
