.page {
  min-height: 100vh;
  padding: var(--space-3);
  /* 给自定义 TabBar 留出空间 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg-base);
}

/* ---------- 个人信息 ---------- */

.profile {
  display: flex;
  align-items: center;
  padding: var(--space-4) var(--space-3);
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-3);
}

.profile-name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  margin-bottom: 8rpx;
}

.profile-sub {
  font-size: var(--fs-label);
  color: var(--text-secondary);
}

/* 版主角标 */
.mod-badge {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-dim);
  border: 2rpx solid var(--accent-border);
  font-size: var(--fs-caption);
  color: var(--accent);
}

/* ---------- 菜单 ---------- */

.menu {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-3);
  border-bottom: 2rpx solid var(--divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-elevated);
}

/* 图标用 CSS 画，不引图片资源 */
.menu-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  margin-right: var(--space-3);
  flex-shrink: 0;
}

.icon-run { background: var(--accent); }
.icon-route { background: var(--accent-alt); }
.icon-fav { background: var(--warn); }
.icon-mod { background: var(--danger); }
.icon-set { background: var(--text-tertiary); }

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  font-size: var(--fs-body);
  color: var(--text-primary);
}

.menu-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

/* 无 menu-main 时 label 自己撑开 */
.menu-item > .menu-label {
  flex: 1;
}

.menu-value {
  font-size: var(--fs-label);
  color: var(--text-tertiary);
  margin-right: var(--space-2);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.version {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-top: var(--space-5);
}
