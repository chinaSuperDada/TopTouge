<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:else>
    <view class="tip" wx:if="{{items.length > 0}}">
      共 {{items.length}} 条已上架。置顶的会排在列表最前。
    </view>

    <view class="route-item" wx:for="{{items}}" wx:key="id">
      <view class="item-head">
        <text class="pin-tag" wx:if="{{item.pinned}}">置顶</text>
        <text class="item-name">{{item.name}}</text>
      </view>

      <view class="item-meta">
        <text>{{item.distanceText}}</text>
        <text class="meta-dot">·</text>
        <text>{{item.curveCount}} 弯</text>
        <text class="meta-dot">·</text>
        <text>🔥 {{item.heat}}</text>
      </view>

      <view class="actions">
        <view class="act act-ghost" data-id="{{item.id}}" bindtap="onViewDetail">看详情</view>
        <view class="act act-ghost" data-id="{{item.id}}" bindtap="onTogglePin">
          {{item.pinned ? '取消置顶' : '置顶'}}
        </view>
        <view
          class="act act-danger"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="onTakeDown"
        >下架</view>
      </view>
    </view>

    <view class="empty" wx:if="{{items.length === 0}}">
      <text>本区还没有上架的路线</text>
    </view>
  </block>
</view>
