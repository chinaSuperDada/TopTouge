.page {
  min-height: 100vh;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
}

.tip {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  line-height: 1.6;
  padding: 0 var(--space-1) var(--space-3);
}

.route-item {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-3);
}

.item-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

/* 置顶标记，一眼看出哪条被推了 */
.pin-tag {
  font-size: 20rpx;
  color: var(--accent);
  background: var(--accent-dim);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-right: var(--space-2);
  flex-shrink: 0;
}

.item-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-emphasis);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: var(--fs-label);
  color: var(--text-secondary);
  margin-bottom: var(--space-3);
}

.meta-dot {
  margin: 0 8rpx;
  color: var(--text-tertiary);
}

.actions {
  display: flex;
  gap: var(--space-2);
}

.act {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--fs-label);
}

.act:active {
  opacity: 0.8;
}

.act-ghost {
  color: var(--text-secondary);
  border: 2rpx solid var(--border-strong);
}

.act-danger {
  color: var(--danger);
  border: 2rpx solid var(--danger-border);
}

.loading,
.empty {
  text-align: center;
  padding: var(--space-6) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}
