.page {
  min-height: 100vh;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
}

.header {
  padding: var(--space-2) var(--space-1) var(--space-4);
}

.header-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  margin-bottom: 10rpx;
}

.header-sub {
  font-size: var(--fs-label);
  color: var(--text-secondary);
}

.menu {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-3);
  border-bottom: 2rpx solid var(--divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-elevated);
}

/* 左侧数字角标，一眼看出有多少待办 */
.menu-badge {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--fs-title);
  font-weight: 700;
  flex-shrink: 0;
  margin-right: var(--space-3);
}

.badge-warn {
  background: rgba(255, 179, 64, 0.14);
  color: var(--warn);
}

.badge-ok {
  background: var(--accent-alt-dim);
  color: var(--accent-alt);
}

.badge-info {
  background: var(--accent-dim);
  color: var(--accent);
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.menu-desc {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.note {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  line-height: 1.6;
  padding: 0 var(--space-2);
  text-align: center;
}

.loading {
  text-align: center;
  padding: var(--space-6) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}
