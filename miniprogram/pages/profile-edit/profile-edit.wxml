<view class="page">
  <!-- 头像 -->
  <view class="section">
    <text class="section-label">头像</text>
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" />
      <view class="avatar-empty" wx:else>＋</view>
    </button>
    <text class="section-hint">点击从微信头像中选，或从相册上传</text>
  </view>

  <!-- 昵称 -->
  <view class="section">
    <text class="section-label">昵称</text>
    <view class="name-row">
      <input
        wx:if="{{editingName}}"
        class="name-input"
        type="nickname"
        value="{{nickName}}"
        placeholder="请输入昵称"
        placeholder-class="input-placeholder"
        maxlength="16"
        focus="{{editingName}}"
        bindinput="onNameInput"
        bindblur="onNameBlur"
        bindconfirm="onNameBlur"
      />
      <view class="name-display" wx:else bindtap="onNameTap">
        <text class="name-text">{{nickName || '未设置'}}</text>
        <text class="name-edit">修改</text>
      </view>
    </view>
    <text class="section-hint">最多 16 个字，会被其他车友看到</text>
  </view>

  <!-- 离屏 canvas：压缩头像用，不显示给用户 -->
  <canvas canvas-id="avatarCanvas" class="hidden-canvas"></canvas>
</view>
