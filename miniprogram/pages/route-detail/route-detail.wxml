<view class="page">
  <!-- 加载 / 错误 -->
  <view class="state-box" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text class="state-text">加载中…</text>
  </view>

  <view class="error-box" wx:elif="{{error}}">
    <text>{{error}}</text>
    <view class="btn btn-ghost retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <!-- 顶部固定区：路线名 + 三个 tab -->
    <view class="header">
      <!-- 只有作者看得到：这条路线还没上公开列表 -->
      <view class="review-strip review-{{route.reviewStatus}}" wx:if="{{reviewNotice}}">
        <text class="review-text">{{reviewNotice}}</text>
      </view>

      <text class="hero-title">{{route.name}}</text>

      <view class="tabs">
        <view
          class="tab {{activeTab === 'home' ? 'tab-on' : ''}}"
          data-tab="home"
          bindtap="onTabChange"
        >路线主页</view>
        <view
          class="tab {{activeTab === 'rank' ? 'tab-on' : ''}}"
          data-tab="rank"
          bindtap="onTabChange"
        >路线排名</view>
        <view
          class="tab {{activeTab === 'comment' ? 'tab-on' : ''}}"
          data-tab="comment"
          bindtap="onTabChange"
        >评论 {{commentCount}}</view>
      </view>
    </view>

    <!-- ============ Tab 1：路线主页 ============ -->
    <block wx:if="{{activeTab === 'home'}}">
      <view class="map-wrap">
        <map
          id="routeMap"
          class="map"
          latitude="{{latitude}}"
          longitude="{{longitude}}"
          scale="{{scale}}"
          polyline="{{polyline}}"
          markers="{{markers}}"
          show-location
        ></map>

        <!-- 微信 map 组件没有内置定位按钮，自己加一个 -->
        <view class="locate-btn" bindtap="onLocateMe">
          <view class="locate-icon"></view>
        </view>
      </view>

      <difficulty-panel route="{{route}}" />

      <view class="start-area">
        <view class="btn btn-primary" bindtap="onStartRun">开始跑山</view>
        <view class="sub-actions">
          <view
            class="btn btn-ghost action-btn {{favorited ? 'btn-fav-on' : ''}}"
            bindtap="onToggleFavorite"
          >{{favorited ? '已收藏' : '收藏'}}</view>
          <view class="btn btn-ghost action-btn" bindtap="onNavigate">分享路线到微信</view>
        </view>
      </view>

      <!-- 相似路线。按轨迹重合度算 -->
      <view class="card similar-card" wx:if="{{similar.length > 0}}">
        <view class="rank-head">
          <text class="rank-title">相似路线</text>
          <text class="rank-sub">{{similar.length}} 条</text>
        </view>

        <view
          class="sim-item"
          wx:for="{{similar}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSimilarTap"
        >
          <view class="sim-main">
            <view class="sim-name-row">
              <text class="sim-name">{{item.name}}</text>
              <!-- 重合度很高时提示可能是同一条路 -->
              <text class="sim-flag" wx:if="{{item.isDuplicate}}">可能重复</text>
            </view>
            <view class="sim-meta">
              <text>{{item.distanceText}}</text>
              <text class="meta-dot">·</text>
              <text>{{item.curveCount}} 弯</text>
              <text class="meta-dot">·</text>
              <text>{{item.city}}</text>
            </view>
          </view>

          <view class="sim-overlap">
            <text class="sim-pct t-num">{{item.overlapText}}%</text>
            <text class="sim-pct-label">重合</text>
          </view>
        </view>
      </view>
    </block>

    <!-- ============ Tab 2：路线排名 ============ -->
    <block wx:elif="{{activeTab === 'rank'}}">
      <view class="card">
        <view class="rank-head">
          <text class="rank-title">成绩榜</text>
          <text class="rank-sub">{{ranking.length}} 人跑过</text>
        </view>

        <view class="rank-item" wx:for="{{ranking}}" wx:key="rank">
          <view class="rank-no {{item.rank <= 3 ? 'rank-no-top' : ''}}">
            {{item.rank}}
          </view>
          <view class="rank-main">
            <view class="rank-user-row">
              <image class="avatar-sm" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
              <view class="avatar-sm avatar-fallback" wx:else>{{item.avatarText}}</view>
              <text class="rank-user">{{item.userName}}</text>
            </view>
          </view>
          <view class="rank-score">
            <text class="score-num">{{item.score}}</text>
            <text class="score-label">分</text>
          </view>
        </view>

        <view class="empty" wx:if="{{ranking.length === 0}}">
          <text>还没有人跑过</text>
          <text class="empty-hint">你可以做第一个</text>
        </view>
      </view>
    </block>

    <!-- ============ Tab 3：评论 ============ -->
    <block wx:else>
      <comment-list
        id="commentList"
        comments="{{route.comments}}"
        bind:submit="onCommentSubmit"
      />

      <road-condition-list
        id="roadConditionList"
        roadConditions="{{route.roadConditions}}"
        bind:submit="onRoadConditionSubmit"
      />
    </block>
  </block>
</view>
