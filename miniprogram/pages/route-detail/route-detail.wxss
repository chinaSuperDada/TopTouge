.page {
  min-height: 100vh;
  padding: var(--space-3);
  /* 详情页不是 tab 页，不需要给 TabBar 留空间 */
  padding-bottom: var(--space-6);
  box-sizing: border-box;
  background: var(--bg-base);
}

/* ---------- 顶部与 Tab ---------- */

.header {
  padding: var(--space-1) var(--space-1) 0;
}

/* 分段控件：灰底容器 + 选中项是蓝色药丸，比单纯文字变色明显得多 */
.tabs {
  display: flex;
  margin-top: var(--space-3);
  padding: 6rpx;
  background: var(--bg-inset);
  border-radius: var(--radius-pill);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--fs-body);
  color: var(--text-secondary);
  border-radius: var(--radius-pill);
  transition: background-color 0.2s, color 0.2s;
}

.tab-on {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}

/* 审核状态提示条。只对未通过的状态显示 */
.review-strip {
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-3);
}

.review-pending {
  background: rgba(217, 119, 6, 0.14);
  border: 2rpx solid rgba(217, 119, 6, 0.4);
}

.review-rejected,
.review-deleted {
  background: rgba(229, 72, 77, 0.14);
  border: 2rpx solid rgba(229, 72, 77, 0.4);
}

.review-text {
  font-size: var(--fs-label);
  color: var(--text-primary);
  line-height: 1.5;
}

/* ---------- 排名榜 ---------- */

/* 空状态（榜单、评论都用得到） */
.empty {
  text-align: center;
  padding: var(--space-5) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}

.empty-hint {
  display: block;
  font-size: var(--fs-caption);
  margin-top: 12rpx;
  opacity: 0.7;
}

/* 次要操作按钮：和主按钮拉开间距 */
.action-btn {
  margin-top: var(--space-2);
}

.card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
}

.rank-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.rank-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-emphasis);
}

.rank-sub {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
  border-bottom: 2rpx solid var(--divider);
}

.rank-item:last-child {
  border-bottom: none;
}

/* 名次徽章：前三名用强调色，其余用灰色 */
.rank-no {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  font-size: var(--fs-label);
  font-weight: 700;
  background: var(--bg-elevated);
  color: var(--text-secondary);
  flex-shrink: 0;
}

/* 前三名的徽章用强调色 */
.rank-no-top {
  background: var(--accent-dim);
  color: var(--accent);
}

.rank-main {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-3);
}

.rank-user-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.avatar-sm {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: var(--bg-elevated);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: var(--text-secondary);
  background: var(--accent-dim);
}

.rank-user {
  display: block;
  font-size: var(--fs-body);
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.rank-score {
  display: flex;
  align-items: baseline;
}

.score-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}

.score-label {
  font-size: var(--fs-caption);
  color: var(--accent);
  margin-left: 4rpx;
}

/* ---------- 状态 ---------- */

.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-6) 0;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: var(--space-2);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-text {
  font-size: var(--fs-label);
  color: var(--text-secondary);
}

.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.retry {
  margin-top: var(--space-3);
  padding: 0 var(--space-5);
  height: 76rpx;
  line-height: 72rpx;
  font-size: var(--fs-body);
}

/* ---------- 头部 ---------- */

.hero-title {
  display: block;
  font-size: 60rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  line-height: 1.25;
  letter-spacing: 1rpx;
  margin-bottom: var(--space-2);
}

/* ---------- 地图 ---------- */

.map-wrap {
  position: relative;
  margin-bottom: var(--space-3);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.map {
  width: 100%;
  height: 460rpx;
  /* 深色底上地图默认太白，压一点亮度让它融入页面 */
  opacity: 0.92;
}

/* 定位按钮：浮在地图右下角 */
.locate-btn {
  position: absolute;
  right: var(--space-2);
  bottom: var(--space-2);
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(20, 20, 20, 0.88);
  border: 2rpx solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.locate-btn:active {
  background: var(--accent);
}

/* 用 CSS 画一个准星图标，避免引入图片 */
.locate-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid var(--accent);
  border-radius: 50%;
  box-sizing: border-box;
}

/* 准星四周的四个短刻度 */
.locate-icon::before,
.locate-icon::after {
  content: '';
  position: absolute;
  background: var(--accent);
}

.locate-icon::before {
  left: 50%;
  top: -8rpx;
  width: 4rpx;
  height: 8rpx;
  margin-left: -2rpx;
  box-shadow: 0 38rpx 0 var(--accent);
}

.locate-icon::after {
  top: 50%;
  left: -8rpx;
  width: 8rpx;
  height: 4rpx;
  margin-top: -2rpx;
  box-shadow: 38rpx 0 0 var(--accent);
}

/* 次要操作按钮：两个并排，和主按钮拉开间距 */
.start-area {
  margin-top: var(--space-4);
}

.sub-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

/* 撑满可用宽度，两个按钮等分 */
.sub-actions .action-btn {
  flex: 1;
  margin-top: 0;
}

/* 已收藏：描边和文字换成强调色，一眼能看出状态 */
.btn-fav-on {
  color: var(--accent);
  border-color: var(--accent);
}



/* ---------- 相似路线 ---------- */

.similar-card {
  margin-top: var(--space-3);
}

.sim-item {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
  border-bottom: 2rpx solid var(--divider);
}

.sim-item:last-child {
  border-bottom: none;
}

.sim-item:active {
  background: var(--bg-elevated);
}

.sim-main {
  flex: 1;
  min-width: 0;
}

.sim-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.sim-name {
  font-size: var(--fs-body);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 重合度很高时提示可能是同一条路 */
.sim-flag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  background: rgba(212, 167, 44, 0.16);
  color: var(--warn);
  font-size: var(--fs-caption);
}

.sim-meta {
  display: flex;
  align-items: center;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}

.meta-dot {
  margin: 0 8rpx;
}

/* 右侧重合度百分比 —— 这块的核心信息，给强调色 */
.sim-overlap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: var(--space-2);
}

.sim-pct {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.1;
}

.sim-pct-label {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-top: 2rpx;
}
