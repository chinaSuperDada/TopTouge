<view class="page">
  <view class="header">
    <text class="header-title">跑山路线</text>
    <text class="header-sub">{{routes.length}} 条路线可挑战</text>
  </view>

  <view class="state-box" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text class="state-text">加载中…</text>
  </view>

  <view class="error-box" wx:elif="{{error}}">
    <text>{{error}}</text>
    <view class="btn btn-ghost retry" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <route-card
      wx:for="{{routes}}"
      wx:key="id"
      route="{{item}}"
      bind:select="onRouteTap"
    />

    <view class="empty" wx:if="{{routes.length === 0}}">
      <text class="empty-line">还没有路线</text>
      <text class="empty-line">点下面的按钮上传第一条</text>
    </view>
  </block>

  <view class="fab-bar">
    <view class="fab-btn fab-ghost" bindtap="onUpload">搜索/选点</view>
    <view class="fab-btn fab-primary" bindtap="onRecord">● 录制路线</view>
  </view>
</view>
