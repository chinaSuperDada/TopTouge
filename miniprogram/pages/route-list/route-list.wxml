<view class="page">
  <!-- 顶栏：板块名 + 当前城市 -->
  <view class="topbar">
    <text class="topbar-title">跑山路线</text>
    <!-- 定位给不出省市，所以城市靠手选。picker 直接套在 view 上，
         比 bindtap 弹 ActionSheet 少一层交互，也能显示当前选中值 -->
    <picker
      mode="selector"
      range="{{provinceLabels}}"
      value="{{provinceIndex}}"
      bindchange="onProvinceChange"
    >
      <view class="location">
        <text class="location-text">{{province === 'all' ? '全部地区' : province}}</text>
        <text class="location-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 活动位：自动轮播 + 手动滑动 + 指示点 -->
  <view class="banner-wrap">
    <swiper
      class="banners"
      autoplay="{{true}}"
      interval="3500"
      duration="400"
      circular
      bindchange="onBannerChange"
    >
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view
          class="banner"
          style="{{item.image ? '' : 'background: ' + item.color}}"
          data-title="{{item.title}}"
          data-link="{{item.link}}"
          bindtap="onBannerTap"
        >
          <!-- 有海报图就用图，没有就用纯色（item.color） -->
          <image
            wx:if="{{item.image}}"
            class="banner-bg"
            src="{{item.image}}"
            mode="aspectFill"
          />
          <view class="banner-mask" wx:if="{{item.image}}"></view>

          <view class="banner-content">
            <text class="banner-tag">{{item.tag}}</text>
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-sub">{{item.subtitle}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 指示点：当前页拉长，未选中是小圆点 -->
    <view class="dots">
      <view
        class="dot {{bannerIndex === index ? 'dot-on' : ''}}"
        wx:for="{{banners}}"
        wx:key="id"
      ></view>
    </view>
  </view>

  <!-- 筛选区 -->
  <view class="filters">
    <view class="filter-row">
      <picker mode="selector" range="{{provinceLabels}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
        <view class="filter {{provinceIndex > 0 ? 'filter-on' : ''}}">
          <text>{{provinceLabels[provinceIndex]}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>

      <picker mode="selector" range="{{cityLabels}}" value="{{cityIndex}}" bindchange="onCityChange">
        <view class="filter {{cityIndex > 0 ? 'filter-on' : ''}}">
          <text>{{cityLabels[cityIndex]}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>

      <picker mode="selector" range="{{difficultyLabels}}" value="{{difficultyIndex}}" bindchange="onDifficultyChange">
        <view class="filter {{difficultyIndex > 0 ? 'filter-on' : ''}}">
          <text>{{difficultyLabels[difficultyIndex]}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="filter-row">
      <picker mode="selector" range="{{roadTypeLabels}}" value="{{roadTypeIndex}}" bindchange="onRoadTypeChange">
        <view class="filter {{roadTypeIndex > 0 ? 'filter-on' : ''}}">
          <text>{{roadTypeLabels[roadTypeIndex]}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>

      <picker mode="selector" range="{{sortLabels}}" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="filter {{sortIndex > 0 ? 'filter-on' : ''}}">
          <text>{{sortLabels[sortIndex]}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </picker>

      <view class="filter filter-reset" bindtap="onResetFilters">重置</view>
    </view>
  </view>

  <!-- 结果统计 -->
  <view class="result-bar">
    <text class="result-count">{{routes.length}} 条路线</text>
  </view>

  <!-- 列表 -->
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:else>
    <view
      class="route-card"
      wx:for="{{routes}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onRouteTap"
    >
      <!-- 左：缩略图（CSS 渐变画，配色按 id 区分） -->
      <view class="thumb {{item.thumbClass}}">
        <view class="thumb-mountain"></view>
        <text class="thumb-label">{{item.roadTypeText}}</text>
      </view>

      <!-- 右：信息 -->
      <view class="card-info">
        <text class="card-name">{{item.name}}</text>

        <!--
          三指标一行。加入爬升后是 365rpx，信息区可用 430rpx，放得下。
          城市挪到底部那行（那里字号更小、也有空位），否则这行要 477rpx 会折行
        -->
        <view class="card-meta">
          <text class="meta-item">{{item.distanceText}}</text>
          <text class="meta-dot">·</text>
          <text class="meta-item">{{item.curveCount}} 弯</text>
          <text class="meta-dot">·</text>
          <text class="meta-item">{{item.elevationGainMeters}}m 爬升</text>
        </view>

        <view class="card-foot">
          <!-- 星级用小方块，比字符整齐 -->
          <view class="stars">
            <view
              class="star {{si < item.difficultyStars ? 'star-on' : ''}}"
              wx:for="{{item.stars}}"
              wx:for-item="s"
              wx:for-index="si"
              wx:key="*this"
            ></view>
          </view>
          <text class="heat">{{item.city}} · 🔥 {{item.heat}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{routes.length === 0}}">
      <text>没有符合条件的路线</text>
      <text class="empty-hint">试试放宽筛选条件</text>
    </view>
  </block>
</view>
