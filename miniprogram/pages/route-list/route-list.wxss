.page {
  min-height: 100vh;
  padding: var(--space-3);
  /* 给自定义 TabBar 留空间（110rpx 高 + 凸起按钮的溢出） */
  padding-bottom: calc(270rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg-base);
}

/* ---------- 顶栏 ---------- */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-1) var(--space-3);
}

.topbar-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  letter-spacing: 1rpx;
}

.location {
  display: flex;
  align-items: center;
  padding: 10rpx var(--space-2);
  background: var(--bg-surface);
  border-radius: var(--radius-pill);
}

.location-text {
  font-size: var(--fs-label);
  color: var(--text-secondary);
}

.location-arrow {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-left: 6rpx;
}

/* ---------- 活动位轮播 ---------- */

.banner-wrap {
  position: relative;
  margin-bottom: var(--space-3);
}

.banners {
  /* swiper 需要显式高度。360rpx 约 5:3，够放海报图 */
  height: 360rpx;
}

.banner {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-sizing: border-box;
  overflow: hidden;
}

/* 有海报图时铺满做背景 */
.banner-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 图片上方压一层暗色渐变，保证白字可读 */
.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent);
}

/* 文字压在图上 */
.banner-content {
  position: relative;
}

.banner:active {
  opacity: 0.85;
}

.banner-tag {
  align-self: flex-start;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 14rpx;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: var(--fs-label);
  color: rgba(255, 255, 255, 0.85);
}

/* 指示点：当前页拉长成横条 */
.dots {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: var(--space-2);
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--border-strong);
  margin: 0 6rpx;
  transition: width 0.25s, background-color 0.25s;
}

.dot-on {
  width: 28rpx;
  background: var(--accent);
}

/* ---------- 筛选 ---------- */

.filters {
  margin-bottom: var(--space-3);
}

.filter-row {
  display: flex;
  margin-bottom: var(--space-2);
}

/* picker 是块级元素，用 flex:1 让每个筛选项等宽 */
.filter-row > picker {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-2);
}

.filter-row > picker:last-child {
  margin-right: 0;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 var(--space-2);
  background: var(--bg-surface);
  border-radius: var(--radius-md);
  font-size: var(--fs-label);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

/* 已生效的筛选条件高亮，让用户知道当前过滤了什么 */
.filter-on {
  color: var(--accent);
  border-color: var(--accent-border);
  background: var(--accent-dim);
}

.filter-arrow {
  font-size: 20rpx;
  margin-left: 6rpx;
  opacity: 0.7;
}

.filter-reset {
  flex: 1;
  margin-right: 0;
  color: var(--text-tertiary);
}

.filter-reset:active {
  color: var(--danger);
}

/* ---------- 结果统计 ---------- */

.result-bar {
  padding: 0 var(--space-1) var(--space-2);
}

.result-count {
  font-size: var(--fs-label);
  color: var(--text-tertiary);
}

/* ---------- 路线卡片：左图右文 ---------- */

.route-card {
  display: flex;
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-2);
  margin-bottom: var(--space-2);
}

.route-card:active {
  background: var(--bg-elevated);
}

/* 缩略图：CSS 渐变 + 一个山峰形状，不引图片资源 */
.thumb {
  position: relative;
  width: 200rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 六套配色，按路线 id 取模分配，相邻卡片颜色不同 */
.thumb-0 { background: linear-gradient(150deg, #1d4ed8, #0e7490); }
.thumb-1 { background: linear-gradient(150deg, #15803d, #166534); }
.thumb-2 { background: linear-gradient(150deg, #b45309, #92400e); }
.thumb-3 { background: linear-gradient(150deg, #7e22ce, #5b21b6); }
.thumb-4 { background: linear-gradient(150deg, #be185d, #9d174d); }
.thumb-5 { background: linear-gradient(150deg, #0e7490, #155e75); }

/* 用两个三角形拼出山峰轮廓 */
.thumb-mountain {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.28), transparent);
  clip-path: polygon(0 100%, 34% 22%, 52% 62%, 70% 34%, 100% 100%);
  opacity: 0.9;
}

/* 左下角的路型标签 */
.thumb-label {
  position: relative;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(0, 0, 0, 0.3);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 10rpx;
}

/* 右侧信息区 */
.card-info {
  flex: 1;
  min-width: 0;
  padding: var(--space-1) var(--space-2) var(--space-1) var(--space-3);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-meta {
  display: flex;
  align-items: center;
  font-size: var(--fs-label);
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
}

/* 加了爬升后一行放不下，允许折行。
   基类的 overflow:hidden + nowrap 是为「宁可裁掉也不要挤成两行」设计的，
   但这里的信息都该看到，所以覆写成可折行 */
.card-meta-wrap {
  flex-wrap: wrap;
  white-space: normal;
  overflow: visible;
}

.meta-item {
  white-space: nowrap;
}

.meta-dot {
  margin: 0 8rpx;
  color: var(--text-tertiary);
}

/* 底部一行：星级 + 热度 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stars {
  display: flex;
}

/* 星级用小方块，比字符整齐且不依赖字体 */
.star {
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
  background: var(--star-empty);
  margin-right: 6rpx;
}

.star-on {
  background: var(--accent);
}

.heat {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}

/* ---------- 状态 ---------- */

.loading,
.empty {
  text-align: center;
  padding: var(--space-6) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}

.empty-hint {
  display: block;
  font-size: var(--fs-caption);
  margin-top: 12rpx;
  opacity: 0.7;
}
