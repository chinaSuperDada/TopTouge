.page {
  min-height: 100vh;
  padding: var(--space-3);
  /* 给自定义 TabBar 留空间（110rpx 高 + 凸起按钮的溢出） */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg-base);
}

/* ---------- 顶栏 ---------- */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-1) var(--space-3);
}

.topbar-title {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  letter-spacing: 1rpx;
}

.location {
  display: flex;
  align-items: center;
  padding: 10rpx var(--space-2);
  background: var(--bg-surface);
  border-radius: var(--radius-pill);
}

.location-text {
  font-size: var(--fs-label);
  color: var(--text-secondary);
}

.location-arrow {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-left: 6rpx;
}

/* ---------- 活动位 ---------- */

.banners {
  white-space: nowrap;
  margin-bottom: var(--space-3);
}

.banner {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  width: 380rpx;
  height: 200rpx;
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-right: var(--space-2);
  box-sizing: border-box;
  vertical-align: top;
}

.banner:active {
  opacity: 0.85;
}

.banner-tag {
  align-self: flex-start;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: var(--fs-label);
  color: rgba(255, 255, 255, 0.85);
}

/* ---------- 筛选 ---------- */

.filters {
  margin-bottom: var(--space-3);
}

.filter-row {
  display: flex;
  margin-bottom: var(--space-2);
}

/* picker 是块级元素，用 flex:1 让每个筛选项等宽 */
.filter-row > picker {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-2);
}

.filter-row > picker:last-child {
  margin-right: 0;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 var(--space-2);
  background: var(--bg-surface);
  border-radius: var(--radius-md);
  font-size: var(--fs-label);
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

/* 已生效的筛选条件高亮，让用户知道当前过滤了什么 */
.filter-on {
  color: var(--accent);
  border-color: var(--accent-border);
  background: var(--accent-dim);
}

.filter-arrow {
  font-size: 20rpx;
  margin-left: 6rpx;
  opacity: 0.7;
}

.filter-reset {
  flex: 1;
  margin-right: 0;
  color: var(--text-tertiary);
}

.filter-reset:active {
  color: var(--danger);
}

/* ---------- 结果统计 ---------- */

.result-bar {
  padding: 0 var(--space-1) var(--space-2);
}

.result-count {
  font-size: var(--fs-label);
  color: var(--text-tertiary);
}

/* ---------- 路线卡片 ---------- */

.route-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-2);
}

.route-card:active {
  background: var(--bg-elevated);
}

.card-main {
  display: flex;
  align-items: center;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  margin-bottom: 12rpx;
}

.card-meta,
.card-sub {
  display: flex;
  align-items: center;
  font-size: var(--fs-label);
  color: var(--text-secondary);
}

.meta-item,
.sub-item {
  white-space: nowrap;
}

.card-sub {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}

.meta-dot {
  margin: 0 10rpx;
  color: var(--text-tertiary);
}

/* 右侧难度 */
.card-stars {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  padding: var(--space-2);
  background: var(--accent-dim);
  border: 2rpx solid var(--accent-border);
  border-radius: var(--radius-md);
  margin-left: var(--space-3);
}

.stars-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}

.stars-label {
  font-size: var(--fs-caption);
  color: var(--accent);
  margin-top: 6rpx;
}

/* ---------- 状态 ---------- */

.loading,
.empty {
  text-align: center;
  padding: var(--space-6) 0;
  color: var(--text-tertiary);
  font-size: var(--fs-label);
}

.empty-hint {
  display: block;
  font-size: var(--fs-caption);
  margin-top: 12rpx;
  opacity: 0.7;
}
