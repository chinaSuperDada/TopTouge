<view class="page">
  <!-- 采集方式切换 -->
  <view class="tabs">
    <view
      class="tab {{mode === 'search' ? 'tab-on' : ''}}"
      data-mode="search"
      bindtap="onSwitchMode"
    >搜索地点</view>
    <view
      class="tab {{mode === 'manual' ? 'tab-on' : ''}}"
      data-mode="manual"
      bindtap="onSwitchMode"
    >地图点选</view>
  </view>

  <!-- ============ 搜索模式 ============ -->
  <block wx:if="{{mode === 'search'}}">
    <view class="hint-box">
      <text class="hint-title">搜索起点和终点，自动规划路线</text>
      <text class="hint-body">规划出的是贴真实道路的路线，比手点连线更准确。可加途经点。</text>
    </view>

    <view class="card search-card">
      <!-- 起点 -->
      <view class="field">
        <view class="field-row">
          <text class="dot dot-start"></text>
          <input
            class="input flex-1"
            value="{{sourceKeyword}}"
            placeholder="起点，例如：西山公园"
            placeholder-class="input-placeholder"
            data-field="source"
            adjust-position="{{true}}"
            cursor-spacing="20"
            bindfocus="onFocusField"
            bindinput="onKeywordInput"
          />
          <!-- 每行右侧都有 ＋：在哪行点，新途经点就插在哪行的下面 -->
          <view
            class="add-btn {{canAddWaypoint ? '' : 'add-btn-off'}}"
            data-after="-1"
            catchtap="onAddWaypoint"
          >＋</view>
        </view>
      </view>

      <!-- 输入框插在起点下面（= 所有途经点之前） -->
      <view class="field" wx:if="{{pickingWaypoint && pickingInsertIndex === 0}}">
        <view class="field-row">
          <text class="dot dot-via"></text>
          <input
            class="input flex-1"
            value="{{waypointKeyword}}"
            placeholder="搜索途经点"
            placeholder-class="input-placeholder"
            focus="{{pickingWaypoint}}"
            data-field="waypoint"
            adjust-position="{{true}}"
            cursor-spacing="20"
            bindinput="onKeywordInput"
          />
          <view class="add-btn add-btn-cancel" catchtap="onCloseCandidates">✕</view>
        </view>
      </view>

      <!--
        途经点。每行右侧的 ＋ 会在该行下面插入新的输入框 ——
        想调整顺序不用先加到最后再用箭头挪
      -->
      <block wx:for="{{waypoints}}" wx:key="key">
        <view class="field">
          <view class="field-row">
            <text class="dot dot-via"></text>
            <view class="via-box flex-1">
              <text class="via-name">{{item.place.name}}</text>
              <!-- 只剩排序。删除挪到右边的 − 圆钮上，和 ＋ 对称 -->
              <view class="via-tools">
                <text
                  class="tool {{index === 0 ? 'tool-off' : ''}}"
                  data-index="{{index}}"
                  catchtap="onMoveWaypointUp"
                >↑</text>
                <text
                  class="tool {{index === waypoints.length - 1 ? 'tool-off' : ''}}"
                  data-index="{{index}}"
                  catchtap="onMoveWaypointDown"
                >↓</text>
              </view>
            </view>
            <!-- − 和 ＋ 并排，一眼能看出「可以加也可以减」 -->
            <view class="del-btn" data-index="{{index}}" catchtap="onRemoveWaypoint">−</view>
            <view
              class="add-btn {{canAddWaypoint ? '' : 'add-btn-off'}}"
              data-after="{{index}}"
              catchtap="onAddWaypoint"
            >＋</view>
          </view>
        </view>

        <!-- 输入框插在这一行下面 -->
        <view class="field" wx:if="{{pickingWaypoint && pickingInsertIndex === index + 1}}">
          <view class="field-row">
            <text class="dot dot-via"></text>
            <input
              class="input flex-1"
              value="{{waypointKeyword}}"
              placeholder="搜索途经点"
              placeholder-class="input-placeholder"
              focus="{{pickingWaypoint}}"
              data-field="waypoint"
              adjust-position="{{true}}"
              cursor-spacing="20"
              bindinput="onKeywordInput"
            />
            <view class="add-btn add-btn-cancel" catchtap="onCloseCandidates">✕</view>
          </view>
        </view>
      </block>

      <!-- 终点 -->
      <view class="field">
        <view class="field-row">
          <text class="dot dot-end"></text>
          <input
            class="input flex-1"
            value="{{destinationKeyword}}"
            placeholder="终点，例如：龙泉寺"
            placeholder-class="input-placeholder"
            data-field="destination"
            adjust-position="{{true}}"
            cursor-spacing="20"
            bindfocus="onFocusField"
            bindinput="onKeywordInput"
          />
          <view
            class="add-btn {{canAddWaypoint ? '' : 'add-btn-off'}}"
            catchtap="onAddWaypoint"
          >＋</view>
        </view>
      </view>

      <!-- 输入框插在最后（终点上面的位置） -->
      <view class="field" wx:if="{{pickingWaypoint && pickingInsertIndex === waypoints.length}}">
        <view class="field-row">
          <text class="dot dot-via"></text>
          <input
            class="input flex-1"
            value="{{waypointKeyword}}"
            placeholder="搜索途经点"
            placeholder-class="input-placeholder"
            focus="{{pickingWaypoint}}"
            data-field="waypoint"
            adjust-position="{{true}}"
            cursor-spacing="20"
            bindinput="onKeywordInput"
          />
          <view class="add-btn add-btn-cancel" catchtap="onCloseCandidates">✕</view>
        </view>
      </view>

      <view class="via-count" wx:if="{{waypoints.length > 0}}">
        已加 {{waypoints.length}} 个途经点{{canAddWaypoint ? '' : '（已达上限）'}}
      </view>

      <view class="search-actions">
        <text class="swap" bindtap="onSwapEnds">交换起终点</text>
        <text class="status" wx:if="{{searching}}">搜索中…</text>
        <text class="status" wx:elif="{{planning}}">规划路线中…</text>
      </view>

      <view class="error-box" wx:if="{{planError}}">{{planError}}</view>
    </view>

    <!--
      候选地点浮层。
      必须是 fixed —— 内联在表单里的话键盘一弹就把列表盖住，
      用户只能凭记忆盲敲。浮层贴在键盘上方（bottom 用键盘高度抬高）。
    -->
    <view
      class="candidates"
      wx:if="{{candidates.length > 0}}"
      style="bottom: {{keyboardHeight}}px"
    >
      <view class="candidates-head">
        <text class="candidates-title">{{searching ? '搜索结果' : '最近使用'}}</text>
        <text class="candidates-close" bindtap="onCloseCandidates">收起</text>
      </view>

      <scroll-view class="candidates-scroll" scroll-y>
        <view
          class="candidate"
          wx:for="{{candidates}}"
          wx:key="name"
          data-index="{{index}}"
          bindtap="onPickCandidate"
        >
          <view class="candidate-main">
            <text class="candidate-name">{{item.name}}</text>
            <text class="candidate-district">{{item.district}}{{item.address}}</text>
          </view>
          <!-- 历史项加个标识，和搜索结果区分开 -->
          <text class="candidate-badge" wx:if="{{!searching}}">历史</text>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- ============ 手动点选模式 ============ -->
  <block wx:else>
    <view class="hint-box">
      <text class="hint-title">在地图上依次点击，连成路线</text>
      <text class="hint-body">第一个点自动成为起点，最后一个点成为终点。至少 2 个点。</text>
    </view>
  </block>

  <!-- 地图（两种模式共用） -->
  <view class="map-wrap">
    <map
      id="pickMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      polyline="{{polyline}}"
      markers="{{markers}}"
      show-location
      bindtap="onMapTap"
    ></map>

    <!-- 微信 map 组件没有内置定位按钮，自己加一个。
         按钮盖在 map 上，点击会被它截获，不会误触发地图取点 -->
    <view class="locate-btn" bindtap="onLocateMe">
      <view class="locate-icon"></view>
    </view>

    <view class="counter">
      <text class="counter-num t-num">{{points.length}}</text>
      <text class="counter-label">个点</text>
    </view>
  </view>

  <!-- 手动模式的工具条 -->
  <view class="toolbar" wx:if="{{mode === 'manual'}}">
    <view class="tool-btn" bindtap="onUndo">撤销一点</view>
    <view class="tool-btn" bindtap="onClearPoints">全部清空</view>
  </view>

  <!-- 表单 -->
  <view class="card">
    <view class="field">
      <text class="field-label">路线名称</text>
      <input
        class="input"
        value="{{name}}"
        placeholder="例如：九曲发夹弯"
        placeholder-class="input-placeholder"
        maxlength="40"
        bindinput="onNameInput"
      />
    </view>

    <view class="field">
      <text class="field-label">路宽</text>
      <picker
        mode="selector"
        range="{{roadWidthLabels}}"
        value="{{roadWidthIndex}}"
        bindchange="onRoadWidthChange"
      >
        <view class="picker">
          <text>{{roadWidthLabels[roadWidthIndex]}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">路型</text>
      <picker
        mode="selector"
        range="{{roadTypeLabels}}"
        value="{{roadTypeIndex}}"
        bindchange="onRoadTypeChange"
      >
        <view class="picker">
          <text>{{roadTypeLabels[roadTypeIndex]}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">谁可以看到</text>
      <view class="vis-row">
        <view
          class="vis-opt {{visibility === 'public' ? 'vis-on' : ''}}"
          data-value="public"
          bindtap="onVisibilityTap"
        >
          <text class="vis-title">公开</text>
          <text class="vis-desc">进入路线库，需要审核</text>
        </view>
        <view
          class="vis-opt {{visibility === 'private' ? 'vis-on' : ''}}"
          data-value="private"
          bindtap="onVisibilityTap"
        >
          <text class="vis-title">私有</text>
          <text class="vis-desc">只有自己可见，无需审核</text>
        </view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">所在地区</text>
      <view class="picker picker-static">
        <text class="{{regionText ? '' : 'picker-placeholder'}}">{{regionText || '提交时自动识别'}}</text>
      </view>
    </view>

    <view class="note">
      距离、弯道数、急弯占比、爬升、难度星级由后端根据坐标自动计算
    </view>
  </view>

  <view class="btn btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">提交路线</view>

  <!--
    提交确认浮层。
    用自定义浮层而不是 wx.showModal —— 后者只支持纯文本，
    排不出「距离 / 弯道 / 爬升 / 星级」这种要一眼看清的表格。
  -->
  <view class="confirm-mask" wx:if="{{confirming}}" bindtap="onCancelConfirm">
    <view class="confirm-sheet" catchtap="onNoop">
      <text class="confirm-title">确认路线信息</text>

      <view class="confirm-name">{{confirmData.name}}</view>

      <view class="confirm-stats">
        <view class="cstat">
          <text class="cstat-num t-num">{{confirmData.distanceText}}</text>
          <text class="cstat-label">里程</text>
        </view>
        <view class="cstat">
          <text class="cstat-num t-num">{{confirmData.curveCount}}</text>
          <text class="cstat-label">弯道</text>
        </view>
        <view class="cstat">
          <text class="cstat-num t-num">{{confirmData.gainText}}</text>
          <text class="cstat-label">爬升</text>
        </view>
        <view class="cstat">
          <text class="cstat-num t-num">{{confirmData.difficultyStars}}</text>
          <text class="cstat-label">难度星</text>
        </view>
      </view>

      <view class="confirm-rows">
        <view class="crow">
          <text class="crow-key">路型</text>
          <text class="crow-val">{{confirmData.roadTypeText}}</text>
        </view>
        <view class="crow">
          <text class="crow-key">路宽</text>
          <text class="crow-val">{{confirmData.roadWidthText}}</text>
        </view>
        <view class="crow">
          <text class="crow-key">地区</text>
          <text class="crow-val">{{confirmData.regionText || '未识别'}}</text>
        </view>
        <view class="crow">
          <text class="crow-key">可见性</text>
          <text class="crow-val {{confirmData.visibility === 'public' ? 'crow-public' : ''}}">
            {{confirmData.visibility === 'public' ? '公开（需审核）' : '私有（仅自己可见）'}}
          </text>
        </view>
      </view>

      <!-- 查重命中时给个提醒，但不拦着不让传 -->
      <view class="confirm-warn" wx:if="{{confirmData.duplicateName}}">
        发现相似路线「{{confirmData.duplicateName}}」，重合度 {{confirmData.duplicateRatio}}%
      </view>

      <view class="confirm-note">统计指标由轨迹自动计算，提交后以服务端结果为准</view>

      <view class="confirm-actions">
        <view class="btn btn-ghost confirm-btn" bindtap="onCancelConfirm">再看看</view>
        <view
          class="btn btn-primary confirm-btn {{submitting ? 'btn-disabled' : ''}}"
          bindtap="onConfirmSubmit"
        >确认提交</view>
      </view>
    </view>
  </view>
</view>
