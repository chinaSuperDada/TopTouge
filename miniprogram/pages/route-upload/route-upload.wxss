.page {
  min-height: 100vh;
  padding: var(--space-3);
  padding-bottom: var(--space-6);
  box-sizing: border-box;
  background: var(--bg-base);
}

/* ---------- 顶部提示 ---------- */

.hint-box {
  margin-bottom: var(--space-3);
}

.hint-title {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 6rpx;
}

.hint-body {
  font-size: var(--fs-label);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ---------- 地图 ---------- */

.map-wrap {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-3);
}

.map {
  width: 100%;
  height: 620rpx;
  opacity: 0.92;
}

/* 采集点计数：浮在地图右下角 */
.counter {
  position: absolute;
  right: var(--space-2);
  bottom: var(--space-2);
  display: flex;
  align-items: baseline;
  background: rgba(15, 18, 22, 0.85);
  border-radius: var(--radius-sm);
  padding: 10rpx var(--space-2);
}

.counter-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
  margin-right: 6rpx;
}

.counter-label {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}

/* ---------- 工具条 ---------- */

.toolbar {
  display: flex;
  margin-bottom: var(--space-3);
}

.tool-btn {
  padding: 14rpx var(--space-3);
  background: var(--bg-surface);
  border-radius: var(--radius-sm);
  font-size: var(--fs-label);
  color: var(--text-secondary);
  margin-right: var(--space-2);
}

.tool-btn:active {
  background: var(--bg-elevated);
  color: var(--accent);
}

/* ---------- 表单 ---------- */

.card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-3);
  margin-bottom: var(--space-4);
}

.field {
  margin-bottom: var(--space-4);
}

.field:last-of-type {
  margin-bottom: var(--space-3);
}

.field-label {
  display: block;
  font-size: var(--fs-label);
  color: var(--text-secondary);
  margin-bottom: var(--space-2);
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-inset);
  border-radius: var(--radius-md);
  padding: 20rpx var(--space-3);
  font-size: var(--fs-body);
  color: var(--text-primary);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.note {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  line-height: 1.6;
  padding-top: var(--space-2);
  border-top: 2rpx solid var(--divider);
}
