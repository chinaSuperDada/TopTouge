<view class="page">
  <!-- ============ 参与算分 ============ -->
  <block wx:if="{{mode === 'ranked'}}">
    <view class="hero">
      <text class="hero-label">综合评分</text>
      <view class="score-wrap">
        <text class="score t-num">{{score}}</text>
        <text class="score-unit">分</text>
      </view>
    </view>

    <view class="rank-card">
      <text class="rank-label">本路线排名</text>
      <view class="rank-value">
        <text class="rank-prefix">第</text>
        <text class="rank-num t-num">{{rank}}</text>
        <text class="rank-suffix">名</text>
      </view>
      <text class="rank-total" wx:if="{{total > 0}}">共 {{total}} 人跑过</text>
    </view>

    <view class="note">
      原始轨迹将在 72 小时后自动清除，仅保留评分和排名
    </view>
  </block>

  <!-- ============ 仅本机记录 ============ -->
  <block wx:else>
    <view class="hero">
      <text class="hero-label">本次记录</text>
      <text class="local-hint">未参与算分，数据仅保存在本机</text>
    </view>

    <view class="rank-card">
      <view class="local-row">
        <view class="local-cell">
          <text class="local-value t-num">{{localElapsed}}</text>
          <text class="local-label">用时</text>
        </view>
        <view class="local-cell">
          <text class="local-value t-num">{{localDistance}}</text>
          <text class="local-label">距离</text>
        </view>
      </view>
    </view>

    <view class="note">
      想在排行榜上留名，下次跑山时选「参与算分」
    </view>
  </block>

  <view class="actions">
    <view class="btn btn-primary" bindtap="onBackToRoute">返回路线详情</view>
  </view>
</view>
