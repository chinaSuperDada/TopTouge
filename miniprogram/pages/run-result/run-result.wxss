.page {
  min-height: 100vh;
  padding: var(--space-4) var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
  display: flex;
  flex-direction: column;
}

/* ---------- 分数区 ---------- */

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-6) 0 var(--space-5);
}

.hero-label {
  font-size: var(--fs-body);
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: var(--space-3);
}

/* 分数是整个页面的主角，用最大字号 */
.score-wrap {
  display: flex;
  align-items: baseline;
}

.score {
  font-size: 160rpx;
  font-weight: 700;
  color: var(--text-emphasis);
  line-height: 1;
  letter-spacing: -4rpx;
}

.score-unit {
  font-size: var(--fs-heading);
  color: var(--text-secondary);
  margin-left: 12rpx;
}

.local-hint {
  font-size: var(--fs-label);
  color: var(--text-tertiary);
}

/* ---------- 排名卡 ---------- */

.rank-card {
  background: var(--bg-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-4);
}

.rank-label {
  font-size: var(--fs-label);
  color: var(--text-secondary);
  margin-bottom: var(--space-2);
}

.rank-value {
  display: flex;
  align-items: baseline;
  color: var(--accent);
}

.rank-prefix,
.rank-suffix {
  font-size: var(--fs-title);
  margin: 0 8rpx;
}

.rank-num {
  font-size: 100rpx;
  font-weight: 700;
  line-height: 1;
}

.rank-total {
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-top: var(--space-2);
}

/* ---------- 仅本机模式的统计 ---------- */

.local-row {
  display: flex;
  width: 100%;
}

.local-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.local-value {
  font-size: var(--fs-heading);
  font-weight: 700;
  color: var(--text-emphasis);
  line-height: 1.1;
  margin-bottom: 8rpx;
}

.local-label {
  font-size: var(--fs-caption);
  color: var(--text-secondary);
}

/* ---------- 说明与操作 ---------- */

.note {
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  line-height: 1.6;
  padding: 0 var(--space-4);
}

.actions {
  margin-top: auto;
  padding-top: var(--space-5);
}
