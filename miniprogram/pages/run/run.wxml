<view class="page">
  <!-- 顶部统计：跑山时这三个数字是主角 -->
  <view class="stats" wx:if="{{status !== 'idle'}}">
    <view class="stat-main">
      <text class="stat-time t-num">{{elapsedText}}</text>
      <text class="stat-label">已用时长</text>
    </view>

    <view class="stat-row">
      <view class="stat-cell">
        <text class="stat-value t-num">{{distanceText}}</text>
        <text class="stat-label">已跑距离</text>
      </view>
      <view class="stat-cell">
        <text class="stat-value t-num">{{pointCount}}</text>
        <text class="stat-label">已采点</text>
      </view>
    </view>

    <!-- 状态角标 -->
    <view class="rec-badge" wx:if="{{status === 'running'}}">
      <view class="rec-dot"></view>
      <text>记录中</text>
    </view>
    <view class="rec-badge rec-paused" wx:elif="{{status === 'paused'}}">
      <text>已暂停</text>
    </view>
    <view class="rec-badge rec-done" wx:else>
      <text>已结束</text>
    </view>
  </view>

  <!-- 未开始时说明 -->
  <view class="hint-box" wx:if="{{status === 'idle'}}">
    <text class="hint-title">{{routeName || '跑山'}}</text>
    <text class="hint-body">开始后会持续记录你的位置。到达终点会自动结束，也可以手动停。</text>
  </view>

  <!-- 快到期终点的提示 -->
  <view class="near-end" wx:if="{{nearEnd && status === 'running'}}">
    <text>{{remainingText}}</text>
  </view>

  <!-- 地图 -->
  <view class="map-wrap">
    <map
      id="runMap"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      polyline="{{polyline}}"
      markers="{{markers}}"
      show-location
      enable-traffic="{{false}}"
    ></map>
  </view>

  <!-- 控制按钮 -->
  <view class="controls">
    <block wx:if="{{status === 'idle'}}">
      <view class="btn btn-primary" bindtap="onStartTap">开始跑山</view>
    </block>

    <block wx:elif="{{status === 'running'}}">
      <view class="btn btn-ghost" bindtap="onPause">暂停</view>
      <view class="btn btn-primary" bindtap="onFinish">结束</view>
    </block>

    <block wx:elif="{{status === 'paused'}}">
      <view class="btn btn-ghost" bindtap="onFinish">结束</view>
      <view class="btn btn-primary" bindtap="onStartTap">继续</view>
    </block>

    <block wx:else>
      <view class="btn btn-ghost" bindtap="onBack">返回</view>
    </block>
  </view>

  <!-- 外部导航：与记录成绩互斥，所以单独一块并说明清楚 -->
  <view class="nav-hint-box">
    <view class="nav-btn" bindtap="onExternalNav">
      <text>用高德导航</text>
      <text class="nav-note">不记录成绩</text>
    </view>
    <text class="nav-explain">
      跳到高德后小程序会进入后台，定位采集会中断，所以这条路无法计分。
      想留成绩请用「开始跑山」。
    </text>
  </view>
</view>

