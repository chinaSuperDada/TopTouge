<view class="page">
  <view class="card menu">
    <view class="menu-item" bindtap="onClearCache">
      <view class="menu-main">
        <text class="menu-label">清除本地缓存</text>
        <text class="menu-desc">只清本机存的临时数据，不影响你的路线和成绩</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onOpenPermission">
      <view class="menu-main">
        <text class="menu-label">位置权限</text>
        <text class="menu-desc">{{locationDesc}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="onCopyVersion">
      <text class="menu-label">版本</text>
      <text class="menu-value">{{version}}</text>
    </view>

    <view class="menu-item">
      <text class="menu-label">运行模式</text>
      <text class="menu-value">{{modeText}}</text>
    </view>
  </view>

  <view class="about">
    <text>TopTouge · 跑山路线</text>
    <text class="about-sub">路线数据来自车友上传，请以实际路况为准</text>
  </view>
</view>
