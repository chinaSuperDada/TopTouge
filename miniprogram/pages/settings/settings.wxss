.page {
  min-height: 100vh;
  padding: var(--space-3);
  box-sizing: border-box;
  background: var(--bg-base);
}

.menu {
  padding: 0;
  overflow: hidden;
  margin-bottom: var(--space-3);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-3);
  border-bottom: 2rpx solid var(--divider);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-elevated);
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-label {
  font-size: var(--fs-body);
  color: var(--text-primary);
}

/* 无 menu-main 时 label 自己撑开 */
.menu-item > .menu-label {
  flex: 1;
}

.menu-desc {
  display: block;
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.menu-value {
  font-size: var(--fs-label);
  color: var(--text-tertiary);
  margin-right: var(--space-2);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.about {
  text-align: center;
  margin-top: var(--space-6);
  font-size: var(--fs-caption);
  color: var(--text-tertiary);
}

.about-sub {
  display: block;
  margin-top: 12rpx;
  opacity: 0.7;
}
